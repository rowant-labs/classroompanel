# Optional: enables live lesson generation. If absent, app uses demo-safe built-in lessons.
# Preferred routing for ClassroomPanel:
# - tutor: Claude Sonnet for teaching quality
# - blackboard: GPT/Gemini for structured visual generation
# - fast: Gemini Flash for lightweight work
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional explicit model overrides. Format: provider:model-id
CLASSROOMPANEL_TUTOR_MODEL=anthropic:claude-opus-4-8
CLASSROOMPANEL_BLACKBOARD_MODEL=anthropic:claude-sonnet-4-6
CLASSROOMPANEL_FAST_MODEL=anthropic:claude-haiku-4-5

# Board pictures (image blocks). Defaults to Gemini flash image, then OpenAI.
# Needs a google or openai key above; without one the board shows a described
# placeholder instead of a picture.
# CLASSROOMPANEL_IMAGE_MODEL=google:gemini-2.5-flash-image
